# ─── Required ────────────────────────────────────────────────
# Your live address, with https:// (no trailing slash)
APP_URL=http://localhost:3000
# MongoDB connection string (MongoDB Atlas free tier works well)
MONGODB_URI=mongodb://127.0.0.1:27017/artora_by_june
# A long random secret. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Emails that are always admins (comma separated)
INITIAL_ADMIN_EMAILS=
NODE_ENV=development
PORT=3000

# ─── Payments: Razorpay (dashboard.razorpay.com → Settings → API Keys) ──
# Without these, checkout falls back to manual UPI (set your UPI ID in Admin → Site content).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook: Settings → Webhooks → URL {APP_URL}/api/payments/webhook, events payment.captured + order.paid
RAZORPAY_WEBHOOK_SECRET=

# ─── Email: Gmail (free, no domain needed) ──────────────────
# 1. In the Gmail account: turn on 2-Step Verification (myaccount.google.com/security)
# 2. Create an App Password: myaccount.google.com/apppasswords → name it "Artora website" → copy the 16 letters
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Name customers see in their inbox
EMAIL_FROM_NAME=Artora by June
# Where enquiries and new-order alerts go (defaults to GMAIL_USER)
ADMIN_NOTIFY_EMAIL=
# Address shown on the contact page (defaults to GMAIL_USER)
SUPPORT_EMAIL=
# Later, with your own domain, switch provider with env vars only (no code change):
#   any SMTP host: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, EMAIL_FROM
#   or Resend:     RESEND_API_KEY, RESEND_FROM_EMAIL=Artora by June <orders@yourdomain.com>
# The first one that is fully filled in wins: Resend, then SMTP, then Gmail.

# ─── Photo storage: Cloudinary (cloudinary.com → Dashboard) ─
# Without these, uploads are turned off in production (Render's disk is wiped on every deploy).
# To store uploads on the server's own disk anyway (e.g. a VPS with a persistent disk), set ALLOW_LOCAL_UPLOADS=1.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Optional ───────────────────────────────────────────────
# Google sign-in (console.cloud.google.com → Credentials → OAuth client)
# Authorised redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INSTAGRAM_HANDLE=artorabyjune
# Privacy-friendly analytics (plausible.io) — your domain, e.g. artorabyjune.com
PLAUSIBLE_DOMAIN=
